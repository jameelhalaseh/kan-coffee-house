{
  "name": "liquor-store-pos",
  "version": "1.0.0",
  "private": true,
  "homepage": ".",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@sentry/react": "^10.55.0",
    "@supabase/supabase-js": "^2.43.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "html-to-image": "^1.11.13",
    "pg": "^8.11.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "cross-env INLINE_RUNTIME_CHUNK=false react-scripts build",
    "server": "node server/index.js",
    "migrate": "node server/migrate.js",
    "seed:admin": "node server/seed-admin.js",
    "seed:users": "node server/seed-users.js",
    "seed:products": "node server/seed-products.js",
    "seed:sales": "node server/seed-demo-sales.js",
    "reset:data": "node server/reset-data.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "demo:setup": "npm run migrate && npm run seed:admin && npm run seed:users && npm run seed:products && npm run seed:sales",
    "heroku-postbuild": "cross-env INLINE_RUNTIME_CHUNK=false react-scripts build"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead"
    ],
    "development": [
      "last 1 chrome version"
    ]
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
