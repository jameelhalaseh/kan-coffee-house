{
  "name": "kan-coffee-house",
  "version": "1.0.0",
  "private": true,
  "homepage": ".",
  "//dev-proxy": "The dev-server proxy lives in src/setupProxy.js, NOT in a `proxy` field here. The shorthand loses to CRA's historyApiFallback (disableDotRule: true) for /client-config.js — see the comment at the top of that file. Do not re-add a `proxy` key; it would be redundant and would reintroduce the ambiguity.",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@sentry/react": "^10.55.0",
    "@supabase/supabase-js": "^2.43.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "html-to-image": "^1.11.13",
    "pg": "^8.11.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "cross-env INLINE_RUNTIME_CHUNK=false react-scripts build",
    "server": "node server/index.js",
    "test:server": "jest --config jest.server.config.js",
    "test:reporting": "jest --config jest.reporting.config.js",
    "test:reporting:pg": "jest --config jest.reporting-pg.config.js",
    "migrate:reporting": "node reporting/migrate.js",
    "test:server:coverage": "jest --config jest.server.config.js --coverage",
    "test:all": "react-scripts test --watchAll=false && jest --config jest.server.config.js",
    "migrate": "node server/migrate.js",
    "seed:admin": "node server/seed-admin.js",
    "seed:users": "node server/seed-users.js",
    "seed:products": "node server/seed-products.js",
    "reset:data": "node server/reset-data.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "setup": "npm run migrate && npm run seed:products",
    "seed:demo-sales-DESTRUCTIVE": "node server/seed-demo-sales.js",
    "heroku-postbuild": "cross-env INLINE_RUNTIME_CHUNK=false react-scripts build"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead"
    ],
    "development": [
      "last 1 chrome version"
    ]
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^27.5.1",
    "supertest": "^7.2.2"
  }
}
