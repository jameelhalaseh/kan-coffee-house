# Copy this to .env and fill in your values. NEVER commit real secrets.

# ── React app vars (must have REACT_APP_ prefix to reach the browser) ─────────
# Empty = same origin as the API (the normal single-dyno deploy).
REACT_APP_API_URL=

# Sentry error tracking (optional — leave blank to disable)
REACT_APP_SENTRY_DSN=

# ── Heroku API server (server/) ───────────────────────────────────────────────
# Set on Heroku via `heroku config:set`. DATABASE_URL is provided by the Postgres addon.
DATABASE_URL=postgres://pos:pos@localhost:5433/liquorpos
NODE_ENV=development
PORT=3001

# Postgres connections this app may hold (pg's own default is 10). On the shared VPS every
# shop hits the SAME Postgres, so the number that matters is shops × this, against
# max_connections in deploy/platform/docker-compose.yml. Leave at 5 unless you have measured
# a reason — and raise max_connections in the same change if you do.
DB_POOL_MAX=5

# The shop's own clock. Decides which TRADING DAY a sale belongs to: History, the daily
# chart and the Z-report all group by this zone, not by UTC. Jordan is UTC+3 year-round, so
# leaving this unset and grouping by UTC would file every sale rung between midnight and
# 03:00 under the previous day.
#
# The browser is TOLD this value (it arrives in window.__CLIENT__), so there is no second
# copy to keep in step any more — the till stamps checkout times in the same zone the
# server groups reports by, by construction.
STORE_TZ=Asia/Amman
SESSION_TTL_HOURS=12

# ── THIS SHOP'S IDENTITY (server/clientConfig.js → GET /client-config.js) ─────
# What makes one image serve every client. The React bundle ships with the Liquor Store
# defaults baked in; whatever is set here overrides them at runtime, so a new shop is an
# .env file and a container restart — not its own `npm ci` and React build.
#
# EVERYTHING HERE IS OPTIONAL. Unset means "use the shipped default", so an existing
# deployment that sets none of it behaves exactly as it did before.
#
# An INVALID value stops the API from starting, on purpose: a tax rate that quietly fell
# back to 16% would print a wrong VAT line on every receipt this shop ever issues, and
# nothing in the app would say so. A refusal to boot shows up in the restart loop instead.
CLIENT_STORE_NAME=Liquor Store
CLIENT_CURRENCY=JOD
# Startup language, 'en' or 'ar'. The AR⇄EN toggle in Settings still works at runtime.
CLIENT_LANG=en
# VAT percentage on the receipt, 0-100. 0 is a real answer for a tax-free shop and is
# honoured as one — it is not read as "unset".
CLIENT_TAX_PCT=16
# Invoice number prefix, e.g. LQ-000123.
CLIENT_INVOICE_PREFIX=LQ
# Seller identity printed on the receipt header. The name defaults to CLIENT_STORE_NAME.
CLIENT_SELLER_NAME=
CLIENT_SELLER_LOCATION=Amman, Jordan
CLIENT_SELLER_TAX_NO=1234567
# Receipt footer.
CLIENT_BILL_FOOTER=Please drink responsibly. Thank you!
CLIENT_BILL_FOOTER_AR=نرجو الشرب بمسؤولية. شكراً لكم
# Optional legal line at the foot of the bill (e.g. the Jordanian invoicing-regulation
# declaration). LEFT BLANK ON PURPOSE — that sentence is a legal statement about THIS
# business, so it is the owner's to assert, not ours to fill in on their behalf.
CLIENT_LEGAL_NOTE=
CLIENT_LEGAL_NOTE_AR=
# Which nav views this shop sees. Unset = all of them, minus `assistant` when there is no
# NVIDIA_API_KEY (no point showing a button that opens a view which can only apologise).
# Must be a subset of: sales, inventory, receive, history, reports, storereports,
# assistant, settings — and must include `sales`.
CLIENT_VIEWS=

# ── Observability ─────────────────────────────────────────────────────────────
# The API logs one JSON object per line to stdout (Docker collects it). Every response
# carries an X-Request-Id header matching its log line, so "it broke at 9pm" becomes a
# lookup rather than a guess.
SERVICE_NAME=liquor-pos
# Any URL that accepts a JSON POST — Slack/Discord incoming webhook, ntfy, etc. Blank
# disables alerting (logs still work). 5xx responses, unhandled rejections and uncaught
# exceptions fire here.
ALERT_WEBHOOK_URL=
# Repeat alerts with the same route+error collapse into one per this many ms (default 5min),
# so a failing dependency can't mute the channel by flooding it.
ALERT_MIN_GAP_MS=300000

# ── AI assistant (NVIDIA NIM — free tier at build.nvidia.com) ─────────────────
# Server-side only; never expose to the browser. Leave blank to disable chat
# (the deterministic insights/alerts still work without a key).
NVIDIA_API_KEY=
# Optional overrides:
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# AI_LOW_STOCK_THRESHOLD=5

# First-admin bootstrap (used once by `npm run seed:admin`, then unset)
ADMIN_USERNAME=owner
ADMIN_PASSWORD=<choose-8+-chars>
ADMIN_EMAIL=

# Staff logins created by `npm run seed:users` (part of `npm run demo:setup`, so this must
# be set or the demo seed stops after the admin). A JSON array on ONE line; passwords are
# bcrypt-hashed at seed time and never stored here in production — set it, run the seed,
# then unset it. allowed_views ⊂ sales, inventory, receive, history, reports, assistant, settings.
USERS_JSON=[{"username":"manager","password":"<8+-chars>","role":"user","allowed_views":["sales","inventory","receive","history","reports","settings"]},{"username":"cashier","password":"<8+-chars>","role":"user","allowed_views":["sales","history"]}]

# ── Forgot-password email (optional) ──────────────────────────────────────────
# Server-side EmailJS REST. Without these, login works but admin forgot-password
# returns 503. Enable "Allow EmailJS API for non-browser applications" in EmailJS.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# ── JoFotara / فوترة — Jordan national e-invoicing (ISTD) ────────────────────
# Server-side only; never exposed to the browser. Leave blank to hide the
# "فوترة" button in History entirely (the POS works fine without it).
# Obtain Client ID + Secret Key from the JoFotara portal (istd.gov.jo).
JOFOTARA_CLIENT_ID=
JOFOTARA_SECRET_KEY=
JOFOTARA_ACTIVITY_NUMBER=
JOFOTARA_SELLER_TIN=
JOFOTARA_SELLER_NAME=
# unregistered | standard | special  (sales-tax registration status)
JOFOTARA_TAXPAYER_TYPE=unregistered
# JOFOTARA_BASE_URL=https://backend.jofotara.gov.jo/core/invoices/
